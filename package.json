{
  "name": "attend",
  "version": "0.1.0",
  "private": true,
  "description": "Institution attendance platform: rotating QR + face verification + device binding",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:domain": "node --experimental-strip-types --test --experimental-test-isolation=none \"apps/api/src/domain/*.test.ts\"",
    "db:generate": "pnpm --filter @attend/db generate",
    "db:migrate": "pnpm --filter @attend/db migrate",
    "db:seed": "pnpm --filter @attend/db seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.8.2"
  }
}
