{
  "name": "@attend/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --experimental-strip-types --watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsup src/server.ts --format esm --target node22 --out-dir dist --clean --sourcemap",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "node --experimental-strip-types src/jobs/worker.ts"
  },
  "dependencies": {
    "@attend/contracts": "*",
    "@attend/db": "*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "drizzle-orm": "^0.38.4",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "pdfkit": "^0.15.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.5",
    "tsup": "^8.3.5",
    "typescript": "^5.8.2",
    "vitest": "^2.1.8"
  }
}
