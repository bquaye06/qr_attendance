# ---------------------------------------------------------------------------
# Attend — copy to .env and fill in. Never commit real values.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug

# --- API ------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0

# Neon pooled connection string (API) and direct string (migrations).
DATABASE_URL=postgresql://attend:attend@localhost:5432/attend
DATABASE_URL_MIGRATE=postgresql://attend:attend@localhost:5432/attend
# Optional: role that owns the biometrics schema. Leave empty in development.
BIOMETRICS_DATABASE_URL=

# Redis for QR nonce/rate-limit/idempotency and SSE fan-out. Empty = in-process.
REDIS_URL=redis://localhost:6379

# 32-byte base64 or hex key that wraps QR signing secrets and TOTP seeds.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MASTER_KEY=replace-me-with-32-byte-base64-key

# Pepper for device fingerprint hashes.
FINGERPRINT_PEPPER=replace-me-with-a-long-random-string

# --- Face service ---------------------------------------------------------
FACE_SERVICE_URL=http://localhost:8000
FACE_SERVICE_SECRET=replace-me-with-the-same-secret-the-face-service-uses
FACE_SERVICE_TIMEOUT_MS=6000

# --- Web ------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
# Server-side rendering talks to the API directly.
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

WEBAUTHN_RP_ID=localhost
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000
SESSION_COOKIE_SECURE=false
COOKIE_DOMAIN=

INSTITUTION_NAME=Demo University
TIME_ZONE=Africa/Accra

# --- Face service process -------------------------------------------------
FACE_SERVICE_SECRET=replace-me-with-the-same-secret-the-api-uses
FACE_MODEL_DIR=models
FACE_MODEL_VERSION=insightface-buffalo_l-arcface-r100
FACE_LIVENESS_THRESHOLD=0.8
